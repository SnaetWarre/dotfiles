[user]
	name = SnaetWarre
	email = warre.snaet@student.howest.be

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = master
[core]
	editor = nvim

# Machine-specific overrides, e.g. a work email on the Mac (see macos/install.sh).
[include]
	path = ~/.gitconfig.local
