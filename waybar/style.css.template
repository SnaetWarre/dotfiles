/* Pywal-compatible retro Waybar template. */

* {
  border: none;
  border-radius: 0;
  box-shadow: none;
  min-height: 0;
  font-family: "Bitstream Vera Sans Mono", "Noto Sans Mono", "monospace";
  font-size: 12px;
  font-weight: normal;
  text-shadow: none;
  transition: none;
}

window#waybar {
  background: $waybar_background;
  color: $color7;
  border-bottom: 1px solid $color8;
}

#custom-separator {
  color: $color8;
  background: transparent;
  padding: 0 5px;
  margin: 0;
}

#clock,
#network,
#custom-power,
#custom-system-stats,
#battery,
#custom-volume,
#custom-brightness,
#custom-asus-profile,
#custom-kb-layout,
#custom-screenrecording-indicator,
#custom-display-mode,
#custom-kbd-brightness {
  background: transparent;
  color: $color7;
  padding: 0 7px;
  margin: 0;
}

#clock {
  color: $color4;
}

#custom-asus-profile,
#custom-kb-layout,
#custom-display-mode {
  color: $color6;
}

#network,
#custom-volume,
#battery {
  color: $color7;
}

#network.disconnected,
#custom-volume.muted,
#battery.warning {
  color: $color3;
}

#battery.critical,
#custom-screenrecording-indicator.recording {
  color: $color1;
  font-weight: bold;
}

#workspaces {
  background: transparent;
  padding: 0;
  margin: 0;
}

#workspaces button {
  background: transparent;
  color: $color8;
  padding: 0 5px;
  margin: 0;
  border: none;
}

#workspaces button.active {
  color: $color0;
  background: $color4;
}

#workspaces button:hover {
  color: $color7;
  background: $color8;
}

tooltip {
  background: $color0;
  border: 1px solid $color8;
  border-radius: 0;
  color: $color7;
  padding: 8px 10px;
}

tooltip label {
  color: $color7;
}
