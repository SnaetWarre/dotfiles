{
  "layer": "top",
  "position": "top",
  "height": 24,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,

  "modules-left": [
    "custom/asus-profile",
    "custom/separator",
    "hyprland/workspaces",
    "custom/separator",
    "custom/kb-layout",
    "custom/separator",
    "group/tray-drawer"
  ],

  "modules-center": [
    "clock",
  ],

  "modules-right": [
    "custom/screenrecording-indicator",
    "custom/separator",
    "custom/display-mode",
    "custom/separator",
    "network",
    "custom/separator", 
    "custom/volume",
    "custom/separator",
    "battery",
  ],

  "custom/separator": {
    "format": "|",
    "tooltip": false
  },

  "group/tray-drawer": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 150,
      "children-class": "tray-hidden",
      "transition-left-to-right": true
    },
    "modules": [
      "custom/tray-toggle",
      "tray"
    ]
  },

  "custom/tray-toggle": {
    "format": ">",
    "tooltip": false
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6,
    "show-passive-items": true
  },

  "clock": {
    "locale": "en_US.utf8",
    "timezone": "Europe/Brussels",
    "format": "{0:%a %d} | {0:%H:%M}",
    "format-alt": "TIME {0:%H:%M:%S}",
    "tooltip": true,
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S}",
    "on-click": "",
    "actions": {
      "on-click-right": "mode"
    }
  },

  "network": {
    "format-wifi": "NET {essid}",
    "format-ethernet": "NET eth",
    "format-alt": "NET",
    "format-disconnected": "NET down",
    "tooltip-format-wifi": "{essid}\ndown {bandwidthDownBytes} up {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}\ndown {bandwidthDownBytes} up {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "alacritty -e nmtui",
    "interval": 5,
    "nospacing": 1
  },

  "custom/asus-profile": {
    "exec": "~/.config/waybar/scripts/asus-profile.sh",
    "interval": 10,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Click to cycle ASUS profile",
    "on-click": "~/.config/waybar/scripts/cycle-asus-profile.sh"
  },

  "custom/kb-layout": {
    "exec": "~/.config/waybar/scripts/kb-layout.sh",
    "return-type": "json",
    "interval": 2,
    "signal": 13,
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/toggle-kb-layout.sh"
  },

  "custom/screenrecording-indicator": {
    "on-click": "~/.config/waybar/modules/toggle-screenrecord.sh",
    "exec": "~/.config/waybar/modules/screen-recording.sh",
    "signal": 8,
    "return-type": "json"
  },

  "custom/display-mode": {
    "exec": "~/.config/waybar/scripts/display-mode.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/display-toggle.sh",
    "signal": 11
  },

  "custom/kbd-brightness": {
    "exec": "~/.config/waybar/scripts/kbd-brightness.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/cycle-kbd-brightness.sh"
  },

  "custom/touchpad": {
    "exec": "~/.config/waybar/scripts/touchpad.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/touchpad-toggle.sh",
    "signal": 12
  },

  "battery": {
    "format": "BAT {capacity}%",
    "format-discharging": "BAT {capacity}%",
    "format-charging": "AC {capacity}%",
    "format-plugged": "AC {capacity}%",
    "format-full": "BAT full",
    "tooltip-format-discharging": "{power:>1.0f}W down {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W up {capacity}%",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  "custom/brightness": {
    "exec": "~/.config/waybar/scripts/brightness.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/brightness-toggle.sh",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "format-active": "[{id}]",
    "format-urgent": "!{id}!",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "sort-by-id": true,
    "persistent-workspaces": {
      "*": 5
    }
  },

  "custom/volume": {
    "exec": "~/.config/waybar/scripts/volume.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 10,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && pkill -RTMIN+10 waybar",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 2%+ && pkill -RTMIN+10 waybar",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%- && pkill -RTMIN+10 waybar"
  },

  "custom/system-stats": {
    "exec": "~/.config/waybar/scripts/system-stats.sh",
    "return-type": "json",
    "interval": 2
  },

  "custom/power": {
    "format": "PWR",
    "tooltip": true,
    "tooltip-format": "Power Menu",
    "on-click": "~/.config/waybar/scripts/powermenu.sh"
  }
}
