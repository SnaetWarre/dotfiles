{
  "current_line_highlight": "all",
  "text_rendering_mode": "subpixel",
  "redact_private_values": false,
  "diff_view_style": "unified",
  "cli_default_open_behavior": "existing_window",
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": true,
    },
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
    "cursor": {
      "type": "registry",
    },
    "github-copilot": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
  },
  "git": {
    "blame": {
      "show_avatar": false,
    },
  },
  "agent_ui_font_family": "Bitstream Vera Sans Mono",
  "agent_ui_font_size": 16.0,
  "agent_buffer_font_family": "Bitstream Vera Sans Mono",
  "agent_buffer_font_size": 17.0,
  "ui_font_family": "Bitstream Vera Sans Mono",
  "ui_font_weight": 400.0,
  "ui_font_size": 16.0,
  "buffer_font_family": "Bitstream Vera Sans Mono",
  "buffer_font_fallbacks": ["JetBrainsMono Nerd Font"],
  "buffer_line_height": {
    "custom": 1.45,
  },
  "buffer_font_weight": 400.0,
  "buffer_font_size": 17.0,
  "session": {
    "trust_all_worktrees": true,
  },
  "show_edit_predictions": false,
  "bottom_dock_layout": "contained",
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "show_diagnostics": "all",
    "git_status": true,
    "file_icons": true,
    "show_close_button": "hover",
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": false,
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_status_icon": true,
    "show_branch_name": true,
    "show_worktree_name": true,
    "show_project_items": true,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false,
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": true,
    "code_actions": true,
  },
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": false,
  },
  "global_lsp_settings": {
    "button": false,
  },
  "search": {
    "button": false,
  },
  "prettier": {
    "allowed": true,
  },
  "minimap": {
    "thumb": "hover",
    "show": "never",
  },
  "scrollbar": {
    "show": "auto",
    "git_diff": true,
    "search_results": true,
    "selected_text": true,
    "selected_symbol": true,
    "diagnostics": "all",
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 2,
    "coloring": "fixed",
    "background_coloring": "disabled",
  },
  "inline_code_actions": false,
  "relative_line_numbers": "disabled",
  "cursor_shape": "bar",
  "auto_update_extensions": {
    "*": true,
  },
  "edit_predictions": {
    "provider": "copilot",
    "codestral": {
      "max_tokens": 150,
    },
    "mode": "eager",
    "copilot": {
      "enable_next_edit_suggestions": false,
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null,
    },
  },
  "vim_mode": false,
  "agent": {
    "button": true,
    "dock": "right",
    "default_width": 640,
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "gpt-5.4",
        "enable_thinking": false,
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-5.4",
        "enable_thinking": false,
      },
    ],
    "tool_permissions": {
      "default": "allow",
    },
    "notify_when_agent_waiting": "all_screens",
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": false,
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex",
    },
    "profiles": {
      "planner": {
        "name": "Planner",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {},
      },
    },
    "model_parameters": [],
  },
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "default_minimum_tokens": "10000",
      },
    },
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "base_keymap": "VSCode",
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Cursor Dark Midnight",
  },
  "autosave": {
    "after_delay": { "milliseconds": 500 },
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right",
  },
  "project_panel": {
    "entry_spacing": "standard",
    "button": true,
    "dock": "left",
    "starts_open": false,
    "default_width": 280.0,
    "auto_reveal_entries": true,
    "sort_mode": "directories_first",
  },
  "git_panel": {
    "button": true,
    "dock": "left",
    "default_width": 360.0,
    "status_style": "icon",
    "group_by": "status",
    "starts_open": false,
  },
  "outline_panel": {
    "dock": "right",
    "button": true,
    "default_width": 320.0,
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": true,
    },
    "shell": "system",
    "dock": "bottom",
    "font_family": "Bitstream Vera Sans Mono",
    "font_size": 16.0,
    "font_weight": 400.0,
    "line_height": "standard",
    "max_scroll_history_lines": 10032,
    "default_height": 320.0,
    "copy_on_select": true,
    "button": true,
  },
  "debugger": {
    "button": true,
    "dock": "bottom",
  },
  "languages": {
    "Python": {
      "language_servers": ["ty"],
    },
  },
}
