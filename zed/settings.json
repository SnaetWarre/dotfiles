// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "current_line_highlight": "all",
  "text_rendering_mode": "subpixel",
  "redact_private_values": false,
  "diff_view_style": "unified",
  "cli_default_open_behavior": "existing_window",
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
    "cursor": {
      "type": "registry",
    },
    "github-copilot": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
  },
  "git": {
    "blame": {
      "show_avatar": false,
    },
  },
  "agent_ui_font_size": 20.0,
  "ui_font_weight": 600.0,
  "ui_font_size": 18.0,
  "buffer_line_height": "standard",
  "buffer_font_weight": 500.0,
  "buffer_font_size": 20.0,
  "session": {
    "trust_all_worktrees": true,
  },
  "show_edit_predictions": false,
  "bottom_dock_layout": "contained",
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "show_diagnostics": "all",
    "git_status": true,
    "file_icons": true,
    "show_close_button": "hover",
  },
  "title_bar": {
    "show_menus": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false,
  },
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": false,
  },
  "global_lsp_settings": {
    "button": false,
  },
  "prettier": {
    "allowed": true,
  },
  "minimap": {
    "thumb": "hover",
    "show": "never",
  },
  "inline_code_actions": false,
  "relative_line_numbers": "disabled",
  "cursor_shape": "block",
  "agent_buffer_font_size": 20.0,
  "auto_update_extensions": {
    "*": true,
  },
  "edit_predictions": {
    "provider": "copilot",
    "codestral": {
      "max_tokens": 150,
    },
    "mode": "eager",
    "copilot": {
      "enable_next_edit_suggestions": false,
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null,
    },
  },
  "vim_mode": false,
  "agent": {
    "button": true,
    "dock": "right",
    "default_width": 640,
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "gpt-5.4",
        "enable_thinking": false,
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-5.4",
        "enable_thinking": false,
      },
    ],
    "tool_permissions": {
      "default": "allow",
    },
    "notify_when_agent_waiting": "all_screens",
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": false,
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex",
    },
    "profiles": {
      "planner": {
        "name": "Planner",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {},
      },
    },
    "model_parameters": [],
  },
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "default_minimum_tokens": "10000",
      },
    },
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_family": "JetBrains Mono",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "base_keymap": "VSCode",
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Cursor Dark Midnight",
  },
  "autosave": {
    "after_delay": { "milliseconds": 100 },
  },
  "collaboration_panel": {
    "button": true,
    "dock": "left",
  },
  "project_panel": {
    "entry_spacing": "standard",
    "button": true,
    "dock": "left",
    "starts_open": false,
  },
  "git_panel": {
    "button": false,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "right",
    "button": false,
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
    "shell": "system",
    "max_scroll_history_lines": 10032,
    "default_height": 300.0,
    "copy_on_select": true,
    "button": true,
  },
  "debugger": {
    "button": true,
  },
  "languages": {
    "Python": {
      "language_servers": ["ty"],
    },
  },
}
